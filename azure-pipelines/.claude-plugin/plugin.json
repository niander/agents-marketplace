{
  "name": "azure-pipelines",
  "description": "Azure Pipelines YAML guidance with schema-aware language server support for pipelines and templates.",
  "version": "1.0.0",
  "author": {
    "name": "niander"
  },
  "license": "MIT",
  "keywords": ["azure", "pipelines", "azure-devops", "yaml", "lsp"],
  "lspServers": {
    "azure-pipelines": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/skills/azure-pipelines/lsp-wrapper.js"],
      "extensionToLanguage": {
        ".yml": "yaml",
        ".yaml": "yaml"
      },
      "startupTimeout": 120000
    }
  }
}
